{
  "name": "epub-gen3",
  "version": "0.2.2",
  "description": "Generate EPUB files from Rust — Node.js native addon",
  "type": "module",
  "main": "index.js",
  "browser": "./dist/browser.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "browser": "./dist/browser.mjs",
      "import": "./dist/index.mjs",
      "require": "./index.js"
    },
    "./browser": {
      "import": "./dist/browser.mjs",
      "types": "./dist/browser.d.mts"
    },
    "./wasm/*": "./wasm/*"
  },
  "napi": {
    "name": "epub-gen3",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:ts": "tsdown",
    "build:wasm": "wasm-pack build ../wasm --target web --out-dir ../node/wasm && node -e \"require('fs').writeFileSync('wasm/.gitignore', '')\"",
    "build:all": "napi build --platform --release && npm run build:wasm && npm run build:ts",
    "prepublishOnly": "npm run build:wasm && npm run build:ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^20.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.4.0",
    "wasm-pack": "^0.13.1"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist/",
    "*.node",
    "wasm/"
  ],
  "license": "MIT"
}
