{
  "name": "epub-gen3",
  "version": "0.2.1",
  "description": "Generate EPUB files from Rust — Node.js native addon",
  "main": "index.js",
  "browser": "./browser.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "browser": "./browser.js",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./browser": "./browser.js",
    "./wasm/*": "./wasm/*"
  },
  "napi": {
    "name": "epub-gen3",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:wasm": "wasm-pack build ../wasm --target web --out-dir ../node/wasm && node -e \"require('fs').writeFileSync('wasm/.gitignore', '')\"",
    "build:all": "napi build --platform --release && npm run build:wasm",
    "prepublishOnly": "npm run build:wasm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "wasm-pack": "^0.13.1"
  },
  "files": [
    "index.js",
    "index.mjs",
    "browser.js",
    "index.d.ts",
    "*.node",
    "wasm/"
  ],
  "license": "MIT"
}